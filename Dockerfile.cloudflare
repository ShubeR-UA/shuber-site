# Cloudflare Containers image for the ShubeR Go application.
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /out/shuber ./cmd/server

FROM alpine:3.22
RUN addgroup -S shuber && adduser -S -G shuber shuber
WORKDIR /app
COPY --from=build /out/shuber /app/shuber
COPY web/static /app/web/static
USER shuber
ENV ADDR=:8080 \
    APP_ENV=production \
    STORAGE_BACKEND=r2 \
    R2_INTERNAL_URL=http://r2.internal \
    DATA_KEY=data/shuber.json \
    COOKIE_SECURE=true \
    SESSION_TTL=168h \
    MAX_UPLOAD_BYTES=94371840
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD wget -qO- http://127.0.0.1:8080/api/health || exit 1
ENTRYPOINT ["/app/shuber"]
