{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shuber-site",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./web/static",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "shuber-media"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "DATA_KEY": "data/shuber.json",
    "COOKIE_SECURE": "true",
    "SESSION_TTL_SECONDS": "604800",
    "MAX_UPLOAD_BYTES": "94371840",
    "SHUBER_ADMIN_LOGIN": "admin"
  }
}
